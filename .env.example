# Firebase web config for project 423715564608
# Fill these from: Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
# Then copy this file to ".env" and restart:  npm run dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=423715564608
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_CONTACT_ENDPOINT=
VITE_PAYPAL_ME=

# ─────────────────────────────────────────────────────────────
# BLOG SOURCE (CMS). Choose where blog posts come from:
#   local (default) | firebase | sanity | contentful | strapi
# "local" uses the bundled Markdown files in src/content/blog/.
# "firebase" reuses your existing Firestore (collection "blogPosts") — no new
# service or token needed; reads are governed by firestore.rules.
# The others fetch at runtime; use READ-ONLY tokens (they ship in the browser
# bundle) or, better, run them at build/prerender time.
# ─────────────────────────────────────────────────────────────
VITE_BLOG_SOURCE=local

# Sanity (public dataset needs no token)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Contentful (Content Delivery API — read-only token)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_DELIVERY_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

# Strapi (read-only API token)
VITE_STRAPI_URL=
VITE_STRAPI_TOKEN=

# ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (Vercel Functions). NO "VITE_" prefix, so these
# are NEVER bundled into the browser. Set them in Vercel → Project →
# Settings → Environment Variables. Openverse needs no key.
# ─────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENVERSE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional CORS allowlist (comma-separated). Leave empty for same-origin only.
ALLOWED_ORIGIN=

# ─────────────────────────────────────────────────────────────
# STRIPE (server-side only). Create products/prices in Stripe, then:
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TRIAL_DAYS=14
APP_URL=https://pikfinder.com
# Firebase Admin service account JSON (single line) for the webhook to set isPremium:
FIREBASE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────────────────────
# ZOHO CONNECTOR (server-side only). Register a "Server-based" app in the
# Zoho API Console (https://api-console.zoho.com). Set the Authorized Redirect
# URI to  <APP_URL>/api/zoho/callback  . Requires FIREBASE_SERVICE_ACCOUNT above.
# ─────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# 32-byte key for AES-256-GCM token encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOHO_TOKEN_KEY=
