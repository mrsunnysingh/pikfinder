# ═══════════════════════════════════════════════════════════════
# PikFinder .gitignore — DO NOT REMOVE ENTRIES WITHOUT REVIEW
# ═══════════════════════════════════════════════════════════════

# ── Secrets & Environment ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
serviceAccountKey*.json
firebase-service-account*.json

# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
.next/
build/

# ── Vercel ────────────────────────────────────────────────────
.vercel/

# ── Firebase ──────────────────────────────────────────────────
.firebase/
.firebaserc

# ── v0 sandbox internal files ─────────────────────────────────
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Internal docs & audits (root-level only) ─────────────────
/*.md
!README.md
docs/

# ── One-time scripts & debug dumps ───────────────────────────
scripts/*
!scripts/prerender.mjs
css_audit.txt
studio_dump.txt

# ── HTML mockups ──────────────────────────────────────────────
pikfinder-logos.html
pikfinder-studio-redesign.html

# ── Zoho widgets (separate repos) ─────────────────────────────
pikfinder/
zoho-*/

# ── Packaged zips (rebuild from source) ───────────────────────
*.zip
